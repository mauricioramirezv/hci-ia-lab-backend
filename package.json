{
  "name": "hci-ia-lab-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "workspaces": [
    "services/identidad",
    "services/aprendizaje",
    "services/comunidad",
    "services/evidencias"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "node scripts/check-architecture.mjs && eslint services --max-warnings=0",
    "test": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run",
    "test:http": "node --import tsx --test services/aprendizaje/tests/http.test.js",
    "test:all": "npm test && npm run test:http",
    "db:provision": "node --env-file-if-exists=.env --import tsx scripts/provision-databases.ts",
    "db:migrate": "npm run migrate --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^10.13.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/swagger": "^9.5.1",
    "fastify": "^5.12.7",
    "pg": "^8.16.3"
  }
}

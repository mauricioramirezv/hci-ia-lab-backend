NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
IDENTIDAD_NODE_ENV=development
IDENTITY_COOKIE_SECURE=false
IDENTITY_COOKIE_SAME_SITE=lax
IDENTITY_SESSION_HOURS=24
IDENTITY_WEB_BASE_URL=http://127.0.0.1:5173/hci-lab-ia/
IDENTITY_MAIL_TRANSPORT=smtp
IDENTITY_SMTP_URL=smtp://mailpit:1025
IDENTITY_SMTP_FROM="HCI Lab IA <lab@hci.local>"
# Brevo is optional. Replace these only in your private .env after creating an account,
# verifying a sender and generating an SMTP key. Never commit the SMTP key.
# IDENTITY_SMTP_URL=smtp://SMTP_LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
# IDENTITY_SMTP_FROM="HCI Lab IA <verified-sender@example.org>"
# Production only: use provider credentials from a secret manager/environment; never commit real values.
# IDENTIDAD_NODE_ENV=production
# IDENTITY_COOKIE_SECURE=true
# IDENTITY_COOKIE_SAME_SITE=none
# IDENTITY_SMTP_URL=smtps://user:password@smtp.example:465
# IDENTITY_SMTP_FROM=HCI Lab <noreply@example.org>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSL=false
POSTGRES_BOOTSTRAP_USER=hci_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=local_only_change_me_bootstrap_please
IDENTIDAD_PORT=3001
IDENTIDAD_DB=identity_db
IDENTIDAD_MIGRATOR=identity_migrator
IDENTIDAD_MIGRATOR_PASSWORD=local_only_change_me_identity_migrator
IDENTIDAD_USER=identity_app
IDENTIDAD_PASSWORD=local_only_change_me_identity_application
APRENDIZAJE_PORT=3002
APRENDIZAJE_DB=learning_db
APRENDIZAJE_MIGRATOR=learning_migrator
APRENDIZAJE_MIGRATOR_PASSWORD=local_only_change_me_learning_migrator
APRENDIZAJE_USER=learning_app
APRENDIZAJE_PASSWORD=local_only_change_me_learning_application
COMUNIDAD_PORT=3003
COMUNIDAD_DB=community_db
COMUNIDAD_MIGRATOR=community_migrator
COMUNIDAD_MIGRATOR_PASSWORD=local_only_change_me_community_migrator
COMUNIDAD_USER=community_app
COMUNIDAD_PASSWORD=local_only_change_me_community_application
EVIDENCIAS_PORT=3004
EVIDENCIAS_DB=evidence_db
EVIDENCIAS_MIGRATOR=evidence_migrator
EVIDENCIAS_MIGRATOR_PASSWORD=local_only_change_me_evidence_migrator
EVIDENCIAS_USER=evidence_app
EVIDENCIAS_PASSWORD=local_only_change_me_evidence_application
IDENTITY_INTERNAL_TOKEN=local_only_change_me_internal_token
# Retention runs at service startup and daily. Values below 30 days are rejected.
EVIDENCE_RETENTION_DAYS=30
